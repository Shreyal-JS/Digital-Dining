# ==============================================================================
# SilvyOS Digital Restaurant Platform - Environment Configuration Template
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MENU_BASE_URL=http://localhost:3000/r

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://silvy_user:silvy_password@localhost:5432/silvyos_db?schema=public

# Authentication / Session Secrets
# Generate with: openssl rand -base64 32
AUTH_SECRET=super_secret_session_encryption_key_min_32_chars
AUTH_SESSION_COOKIE_NAME=silvyos_session
AUTH_SESSION_MAX_AGE_SECONDS=604800 # 7 days

# Storage Provider (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local # Options: local | s3 | r2
STORAGE_BUCKET_NAME=silvyos-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Rate Limiting & Anti-Spam
RATE_LIMIT_FEEDBACK_PER_MINUTE=5
RATE_LIMIT_PUBLIC_API_PER_MINUTE=60
